extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.page-shell
    include ../../partials/list-btn-users.pug

    .row
      .col-12
        +box-head("Danh sách bạn bè")

    .row(data-users-friend=user.id)
      each user in users
        .col-md-6(user-id=user.id)
          .box-user
            .inner-avatar
              img(src=(user.avatar ? user.avatar : "/images/default.jpg"), alt=user.fullName)
            .inner-info
              .inner-name #{user.fullName}
              .inner-buttons
                a.btn.btn-sm.btn-primary(href=`/chat/${user.infoFriend.room_chat_id}`) Nhắn tin
            .inner-status(status=user.statusOnline)
              i.fa.fa-circle
block scripts
  script(type="module" src="/js/users.js")
