extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  .admin-page
    h1.page-title Cài đặt chung

    +alert(success, error)

    form.admin-form(
      action=`${prefixAdmin}/settings/general?_method=PATCH`
      method="POST"
      enctype="multipart/form-data"
    )
      .form-group
        label(for="websiteName") Tên website
        input#websiteName.form-control(
          type="text"
          name="websiteName"
          value=(settings.websiteName ? settings.websiteName : '')
        )

      .form-group(upload-image)
        label(for="logo") Logo
        input#logo.form-control-file(
          type="file"
          name="logo"
          accept="image/*"
          upload-image-input
        )
        img.img-thumbnail.mt-2(
          src=(settings.logo ? settings.logo : '')
          alt="Logo"
          upload-image-preview
        )

      .form-group
        label(for="phone") Số điện thoại
        input#phone.form-control(
          type="text"
          name="phone"
          value=(settings.phone ? settings.phone : '')
        )

      .form-group
        label(for="email") Email
        input#email.form-control(
          type="text"
          name="email"
          value=(settings.email ? settings.email : '')
        )

      .form-group
        label(for="address") Địa chỉ
        input#address.form-control(
          type="text"
          name="address"
          value=(settings.address ? settings.address : '')
        )

      .form-group
        label(for="copyright") Copyright
        input#copyright.form-control(
          type="text"
          name="copyright"
          value=(settings.copyright ? settings.copyright : '')
        )

      .form-group
        button.btn.btn-primary(type="submit") Cập nhật
