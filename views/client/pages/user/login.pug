extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert(success, error)

  .auth-page
    .container
      .auth-card
        h1 Đăng nhập
        p.auth-sub Chào mừng bạn quay lại

        form(action="/user/login" method="POST")
          .form-group
            label(for="email") Email
            input#email.form-control(
              type="email"
              name="email"
              required
            )

          .form-group
            label(for="password") Mật khẩu
            input#password.form-control(
              type="password"
              name="password"
              required
            )

          .form-group
            button.btn.btn-primary.btn-block(type="submit") Đăng Nhập

          .auth-links
            a(href="/user/password/forgot") Quên mật khẩu?
