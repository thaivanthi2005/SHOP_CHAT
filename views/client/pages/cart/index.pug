extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/alert.pug

block main
  +alert(success, error)
  .container.page-shell
    .row
      .col-12
        +box-head("Giỏ hàng")

    .row
      .col-12
        if productInfo && productInfo.length > 0
          .page-panel
            table.table.table-bordered
              thead
                tr
                  th STT
                  th Ảnh
                  th Tên
                  th Giá
                  th Số lượng
                  th Tổng tiền
                  th Hành động
              tbody
                each item, index in productInfo
                  tr
                    td= index + 1
                    td
                      img(src=item.thumbnail style="width: 80px" alt=item.title)
                    td
                      a(href=`/products/detail/${item._id}`)= item.title
                    td
                      del= item.price + ' VNĐ'
                      |  → 
                      strong= item.pricenew + ' VNĐ'
                    td
                      input.quantity-input(
                        type="number"
                        name="quantity"
                        value=item.quantity
                        min="1"
                        product_Id=`${item._id}`
                        style="width: 72px"
                        aria-label="Số lượng"
                      )
                    td= item.pricenew * item.quantity + ' VNĐ'
                    td
                      a.btn.btn-danger.btn-sm(href=`/cart/delete/${item._id}`) Xóa

            .cart-summary
              h3
                | Tổng đơn hàng: 
                strong= productInfo.reduce((total, item) => total + item.pricenew * item.quantity, 0) + ' VNĐ'
              a.btn.btn-success(href="/checkout") THANH TOÁN
        else
          .empty-state
            p Giỏ hàng của bạn đang trống.
            a(href="/products") Tiếp tục mua sắm
