extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert(success, error)

  .auth-page
    .container
      .auth-card
        h1 Đăng ký tài khoản
        p.auth-sub Tạo tài khoản để mua sắm nhanh hơn

        form(action="/user/register" method="POST")
          .form-group
            label(for="fullName") Họ và tên
            input#fullName.form-control(
              type="text"
              name="fullName"
              required
            )

          .form-group
            label(for="email") Email
            input#email.form-control(
              type="email"
              name="email"
              required
            )

          .form-group
            label(for="password") Mật khẩu
            input#password.form-control(
              type="password"
              name="password"
              required
            )

          button.btn.btn-primary.btn-block(type="submit") Đăng ký
