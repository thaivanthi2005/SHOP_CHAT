extends ../../layouts/auth.pug

include ../../mixins/alert.pug

block main
  +alert(success, error)

  .card.shadow
    .card-body
      h3.text-center.mb-4 Đăng nhập

      form(
        action=`${prefixAdmin}/auth/login`
        method="POST"
      )
        .form-group.mb-3
          label(for="email") Email
          input#email.form-control(
            type="email"
            name="email"
            placeholder="Nhập email"
            required
          )

        .form-group.mb-3
          label(for="password") Mật khẩu
          input#password.form-control(
            type="password"
            name="password"
            placeholder="Nhập mật khẩu"
            required
          )

        .form-check.mb-3
          input#remember.form-check-input(
            type="checkbox"
            name="remember"
          )
          label.form-check-label(for="remember") Nhớ đăng nhập

        button.btn.btn-primary.w-100(type="submit") Đăng nhập

        .text-center.mt-3
          a(href=`${prefixAdmin}/auth/forgot-password`) Quên mật khẩu?
