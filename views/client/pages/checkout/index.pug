extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/alert.pug

block main
  +alert(success, error)
  .container.page-shell
    .row
      .col-12
        +box-head("ĐẶT HÀNG")

    .row
      .col-12
        if productInfo && productInfo.length > 0
          .page-panel
            table.table.table-bordered
              thead
                tr
                  th STT
                  th Ảnh
                  th Tên
                  th Giá
                  th Số lượng
                  th Tổng tiền
              tbody
                each item, index in productInfo
                  tr
                    td= index + 1
                    td
                      img(src=item.thumbnail style="width: 80px" alt=item.title)
                    td
                      a= item.title
                    td
                      del= item.price + ' VNĐ'
                      |  → 
                      strong= item.pricenew + ' VNĐ'
                    td= item.quantity
                    td= item.pricenew * item.quantity + ' VNĐ'

            .checkout-summary
              h3.order-total
                | Tổng đơn hàng: 
                strong= productInfo.reduce((total, item) => total + item.pricenew * item.quantity, 0) + ' VNĐ'

            form.checkout-form(action="/checkout/order" method="POST")
              .form-group
                label(for="fullName") Họ tên
                input#fullName.form-control(
                  type="text"
                  name="fullName"
                  placeholder="Nhập họ tên"
                  required
                )

              .form-group
                label(for="phone") Số điện thoại
                input#phone.form-control(
                  type="text"
                  name="phone"
                  placeholder="Nhập số điện thoại"
                  required
                )

              .form-group
                label(for="address") Địa chỉ
                input#address.form-control(
                  type="text"
                  name="address"
                  placeholder="Nhập địa chỉ"
                  required
                )

              button.btn.btn-success.btn-block.w-100.mt-2(type="submit") ĐẶT HÀNG
        else
          .empty-state
            p Chưa có sản phẩm nào trong giỏ hàng.
            a(href="/products") Quay lại mua sắm
