doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{title || "Admin Auth"}
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin="")
    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )
    link(
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    )
    link(
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    )
    style.
      body {
        font-family: "Plus Jakarta Sans", "Segoe UI", sans-serif;
        background:
          radial-gradient(900px 360px at 10% 0%, rgba(20, 184, 166, 0.22), transparent 55%),
          radial-gradient(700px 320px at 100% 100%, rgba(15, 23, 42, 0.18), transparent 50%),
          linear-gradient(160deg, #0b1220, #111827 55%, #134e4a);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
      }
      .auth-box {
        width: 100%;
        max-width: 460px;
        padding: 24px;
      }
      .auth-brand {
        text-align: center;
        margin-bottom: 22px;
        color: #fff;
      }
      .auth-brand__mark {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        background: linear-gradient(145deg, #14b8a6, #0f766e);
        box-shadow: 0 10px 24px rgba(20, 184, 166, 0.35);
        margin-bottom: 12px;
      }
      .auth-brand h2 {
        margin: 0;
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.03em;
      }
      .auth-brand p {
        margin: 6px 0 0;
        color: rgba(255,255,255,0.7);
        font-size: 14px;
      }
      .card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 20px 48px rgba(2, 6, 23, 0.35);
        overflow: hidden;
      }
      .card-body {
        padding: 28px !important;
      }
      .form-control {
        border-radius: 10px;
        border: 1.5px solid #e2e8f0;
        padding: 11px 14px;
      }
      .form-control:focus {
        border-color: #0f766e;
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
      }
      .btn-primary {
        border: none;
        border-radius: 999px;
        background: linear-gradient(135deg, #14b8a6, #0f766e);
        font-weight: 700;
        padding: 11px;
        box-shadow: 0 10px 22px rgba(15, 118, 110, 0.3);
      }
      .btn-primary:hover {
        filter: brightness(1.05);
      }
      a {
        color: #0f766e;
        font-weight: 600;
        text-decoration: none;
      }
      .auth-footer {
        text-align: center;
        margin-top: 18px;
        color: rgba(255,255,255,0.55);
        font-size: 12px;
      }

  body
    .auth-box
      .auth-brand
        .auth-brand__mark A
        h2 Admin Panel
        p Đăng nhập để quản trị hệ thống
      block main
      .auth-footer © 2026 Begin Admin

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
    )
