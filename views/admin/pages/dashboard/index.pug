extends ../../layouts/default.pug

block main
  .dashboard
    .dashboard-header
      h1.dashboard-title Dashboard
      p.dashboard-subtitle Tổng quan hệ thống quản trị

    .dashboard-grid
      .dashboard-card.dashboard-card--profile
        .dashboard-card__head
          span.dashboard-card__label Thông tin tài khoản
        .dashboard-card__body.dashboard-profile
          if user.avatar
            img.dashboard-avatar(src=user.avatar alt="Avatar")
          else
            .dashboard-avatar.dashboard-avatar--fallback #{user.fullName ? user.fullName.charAt(0) : "A"}
          .dashboard-profile__info
            p.dashboard-profile__name #{user.fullName}
            if user.email
              p.dashboard-profile__meta
                span Email
                b #{user.email}
            if user.phone
              p.dashboard-profile__meta
                span Số điện thoại
                b #{user.phone}
            if roles.title
              p.dashboard-profile__meta
                span Phân quyền
                b.dashboard-badge #{roles.title}

      .dashboard-card
        .dashboard-card__head
          span.dashboard-card__label Danh mục sản phẩm
          span.dashboard-card__icon.dashboard-card__icon--teal
        .dashboard-card__body
          p.dashboard-stat__total #{statistic.categoryProduct.total}
          .dashboard-stat__row
            .dashboard-stat__item
              span Hoạt động
              b.dashboard-stat__active #{statistic.categoryProduct.active}
            .dashboard-stat__item
              span Dừng hoạt động
              b.dashboard-stat__inactive #{statistic.categoryProduct.inactive}

      .dashboard-card
        .dashboard-card__head
          span.dashboard-card__label Sản phẩm
          span.dashboard-card__icon.dashboard-card__icon--blue
        .dashboard-card__body
          p.dashboard-stat__total #{statistic.product.total}
          .dashboard-stat__row
            .dashboard-stat__item
              span Hoạt động
              b.dashboard-stat__active #{statistic.product.active}
            .dashboard-stat__item
              span Dừng hoạt động
              b.dashboard-stat__inactive #{statistic.product.inactive}

      .dashboard-card
        .dashboard-card__head
          span.dashboard-card__label Tài khoản admin
          span.dashboard-card__icon.dashboard-card__icon--slate
        .dashboard-card__body
          p.dashboard-stat__total #{statistic.account.total}
          .dashboard-stat__row
            .dashboard-stat__item
              span Hoạt động
              b.dashboard-stat__active #{statistic.account.active}
            .dashboard-stat__item
              span Dừng hoạt động
              b.dashboard-stat__inactive #{statistic.account.inactive}

      .dashboard-card
        .dashboard-card__head
          span.dashboard-card__label Tài khoản client
          span.dashboard-card__icon.dashboard-card__icon--amber
        .dashboard-card__body
          p.dashboard-stat__total #{statistic.user.total}
          .dashboard-stat__row
            .dashboard-stat__item
              span Hoạt động
              b.dashboard-stat__active #{statistic.user.active}
            .dashboard-stat__item
              span Dừng hoạt động
              b.dashboard-stat__inactive #{statistic.user.inactive}
