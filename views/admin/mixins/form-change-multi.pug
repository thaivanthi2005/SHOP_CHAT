mixin form-change-multi(prefixAdmin)
  form.form-change-multi(
    action=prefixAdmin
    method="POST"
    form-change-multi
  )
    .form-change-multi__row
      select.form-control.form-control-sm(name="type")
        option(disabled selected) -- Chọn hành động --
        option(value="InStock") Còn hàng
        option(value="OutStock") Hết hàng
        option(value="delete-all") Xóa tất cả
        option(value="change-position") Thay đổi vị trí
      input.d-none(
        type="text"
        name="ids"
        value=""
      )
      button.btn.btn-primary.btn-sm(type="submit") Áp dụng
