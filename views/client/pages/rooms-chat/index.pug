extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.page-shell
    .row
      .col-12
        +box-head("Danh sách phòng")

    .row.mb-3
      .col-12
        a.btn.btn-sm.btn-success(href="/rooms-chat/create") Tạo phòng chat

    .row
      each room in listRoomChat
        .col-md-6
          .box-room
            .inner-avatar
              img(
                src=room.avatar || "https://robohash.org/" + room._id + ".png"
                alt=room.title
              )
            .inner-info
              .inner-name #{room.title}
              .inner-buttons
                a.btn.btn-sm.btn-primary(href="/chat/" + room._id) Nhắn tin
