extends ../../layouts/default.pug
include ../../mixins/alert.pug
block main
  if(roles.permissions.includes("roles_create"))
    .admin-page
      h1.page-title Thêm mới nhóm quyền
      +alert(success, error)

      form.admin-form(
        action=`${prefixAdmin}/roles/create`
        method="POST"
        enctype="multipart/form-data"
        id="form-create-roles"
      )
        .form-group
          label(for="title") Tiêu đề
          input#title.form-control(
            type="text"
            name="title"
          )

        .form-group
          label(for="my-expressjs-tinymce-app") Mô tả
          textarea#my-expressjs-tinymce-app.form-control(
            name="description"
            rows="5"
          )

        .form-group
          button.btn.btn-primary(type="submit") Thêm nhóm quyền
