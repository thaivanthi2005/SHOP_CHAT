extends ../../layouts/default.pug
include ../../mixins/category-tree.pug

block main
  if(roles.permissions.includes("products-category_view"))
    .admin-page
      h1.page-title Danh mục sản phẩm

      .admin-toolbar
        .add-category
          a(href=`${prefixAdmin}/category/create`) Thêm danh mục

      .categories
        +categoryTree(products)
