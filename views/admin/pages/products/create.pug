extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/category-option.pug
block main
  if(roles.permissions.includes("products_edit"))
    h1.mb-4 Thêm sản phẩm
    +alert(success, error)
    form(
      action=`${prefixAdmin}/products/create`
      method="POST"
      enctype="multipart/form-data"
      id="form-create-product"
    )

      //- Tiêu đề
      .form-group
        label(for="title") Tiêu đề
        input.form-control(
          type="text"
          id="title"
          name="title"
        )
      .form-group
        label(for="product_category_id") Danh mục cha
        select.form-control(
          id="product_category_id"
          name="product_category_id"
        )
          - const parentId = products.product_category_id ? products.product_category_id.toString() : ''
          option(value="" selected=(parentId === '')) -- Danh mục gốc --
          +categoryOptions(layoutcategory, parentId)
      //- Mô tả
      .form-group
        label(for="my-expressjs-tinymce-app") Mô tả
        textarea.form-control(
          id="my-expressjs-tinymce-app"
          name="description"
          rows="5")
      //- Nổi bật
      .form-group
        .form-check.form-check-inline
          input.form-check-input(
            type="radio"
            id="featuredActive"
            name="featured"
            value="1"
          )
          label.form-check-label(for="featuredActive") Nổi bật

        .form-check.form-check-inline
          input.form-check-input(
            type="radio"
            id="featuredInactive"
            name="featured"
            value="0"
          )
          label.form-check-label(for="featuredInactive") Không nổi bật
      //- Giá
      .form-group
        label(for="price") Giá
        input.form-control(
          type="number"
          id="price"
          name="price"
          value="0"
          min="0"
        )

      //- Giảm giá
      .form-group
        label(for="discount") % Giảm giá
        input.form-control(
          type="number"
          id="discount"
          name="discountPercentage"
          value="0"
          min="0"
        )

      //- Số lượng
      .form-group
        label(for="stock") Số lượng
        input.form-control(
          type="number"
          id="stock"
          name="stock"
          value="0"
          min="0"
        )

      //- Ảnh
      div(class="form-group" 
      upload-image)
        label(for="thumbnail") Ảnh
        input.form-control-file(
          type="file"
          id="thumbnail"
          accept="image/*"
          name="thumbnail"
          upload-image-input
        )
        img(
          src=""
          alt="Preview"
          width="200"
          upload-image-preview
        )
        button.btn.btn-secondary(type="button" upload-image-delete) Xóa ảnh

      //- Vị trí
      .form-group
        label(for="position") Vị trí
        input.form-control(
          type="number"
          id="position"
          name="position"
          placeholder="Tự động tăng"
          min="1"
        )

      //- Trạng thái
      .form-group
        label Trạng thái
        .form-check.form-check-inline
          input.form-check-input(
            type="radio"
            id="statusActive"
            name="status"
            value="InStock"
            checked
          )
          label.form-check-label(for="statusActive") Hoạt động

        .form-check.form-check-inline
          input.form-check-input(
            type="radio"
            id="statusInactive"
            name="status"
            value="OutStock"
          )
          label.form-check-label(for="statusInactive") Dừng hoạt động

      //- Submit
      .form-group
        button.btn.btn-primary(type="submit") Thêm sản phẩm
