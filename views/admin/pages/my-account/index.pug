extends ../../layouts/default.pug

block main
  .admin-page
    h1.page-title Thông tin cá nhân

    .profile-view
      if (user.avatar)
        img.mb-3(src=user.avatar width="150" alt=user.fullName)
      else
        img.mb-3(src="/admin/images/avatar.png" width="150" alt="Avatar")

      if (user.fullName)
        p Họ tên: 
          b #{user.fullName}

      if (user.email)
        p Email: 
          b #{user.email}

      if (user.phone)
        p Số điện thoại: 
          b #{user.phone}

      p
        span Trạng thái: 
        b #{user.status == "active" ? "Hoạt động" : "Dừng hoạt động"}

      if (role.title)
        p Phân quyền: 
          b #{role.title}

      a.btn.btn-primary.mt-2(
        href=`${prefixAdmin}/my-account/edit`
      ) Chỉnh sửa thông tin
