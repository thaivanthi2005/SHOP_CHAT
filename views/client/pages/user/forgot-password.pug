extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert(success, error)

  .auth-page
    .container
      .auth-card
        h1 Lấy lại mật khẩu
        p.auth-sub Nhập email để nhận mã xác nhận

        form(action="/user/password/forgot" method="POST")
          .form-group
            label(for="email") Email
            input#email.form-control(
              type="email"
              name="email"
              required
            )
          .form-group
            button.btn.btn-primary.btn-block(type="submit") Gửi mail xác nhận
