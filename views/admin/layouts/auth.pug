doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{title || "Admin Auth"}
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin="")
    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )
    link(
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    )
    link(
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    )
    style.
      body {
        font-family: "DM Sans", "Segoe UI", sans-serif;
        background:
          radial-gradient(900px 360px at 10% 0%, rgba(65, 95, 255, 0.28), transparent 55%),
          radial-gradient(700px 320px at 100% 100%, rgba(91, 124, 255, 0.16), transparent 50%),
          linear-gradient(160deg, #06101f, #0b1220 55%, #0c1a33);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
      }
      .auth-box {
        width: 100%;
        max-width: 460px;
        padding: 24px;
      }
      .auth-brand {
        text-align: center;
        margin-bottom: 22px;
        color: #fff;
      }
      .auth-brand__mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 32px;
        padding: 0 14px;
        font-family: "Space Grotesk", "Segoe UI", sans-serif;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 0.08em;
        background: linear-gradient(135deg, #5b7cff, #415fff);
        box-shadow: 0 10px 24px rgba(65, 95, 255, 0.35);
        margin-bottom: 12px;
      }
      .auth-brand h2 {
        margin: 0;
        font-family: "Space Grotesk", "Segoe UI", sans-serif;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.03em;
      }
      .auth-brand p {
        margin: 6px 0 0;
        color: rgba(255,255,255,0.7);
        font-size: 14px;
      }
      .card {
        border: none;
        border-radius: 8px;
        box-shadow: 0 20px 48px rgba(2, 6, 23, 0.35);
        overflow: hidden;
      }
      .card-body {
        padding: 28px !important;
      }
      .form-control {
        border-radius: 6px;
        border: 1.5px solid #e2e8f0;
        padding: 11px 14px;
      }
      .form-control:focus {
        border-color: #415fff;
        box-shadow: 0 0 0 3px rgba(65, 95, 255, 0.18);
      }
      .btn-primary {
        border: none;
        border-radius: 6px;
        background: linear-gradient(135deg, #5b7cff, #415fff);
        font-weight: 700;
        font-family: "Space Grotesk", "Segoe UI", sans-serif;
        padding: 11px;
        box-shadow: 0 10px 22px rgba(65, 95, 255, 0.3);
        cursor: pointer;
      }
      .btn-primary:hover {
        filter: brightness(1.05);
      }
      a {
        color: #415fff;
        font-weight: 600;
        text-decoration: none;
      }
      .auth-footer {
        text-align: center;
        margin-top: 18px;
        color: rgba(255,255,255,0.55);
        font-size: 12px;
      }

  body
    .auth-box
      .auth-brand
        .auth-brand__mark ADMIN
        h2 Admin Panel
        p Đăng nhập để quản trị hệ thống
      block main
      .auth-footer © 2026 Vivo × ZEISS Admin

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
    )
