extends ../../layouts/default.pug
include ../../mixins/category-tree.pug
include ../../mixins/alert.pug
block main
  if(roles.permissions.includes("roles_permissions"))
    .admin-page
      +alert(success, error)
      h1.page-title Phân quyền

      if(roles)
        .text-right
          button.btn.btn-primary.mb-3(
            type="submit"
            button-submit
            data-roles=`${JSON.stringify(roles1)}`
          ) Cập nhật

        table.table.table-hover.table-sm(table-permissions)
          thead
            tr
              th Tính năng
              each item in roles1
                th.text-center #{item.title}
          tbody
            tr(data-name="id")
              td
              each item in roles1
                td.text-center
                  input(type="text" value=item._id)
            tr
              td(colspan="4")
                b Danh mục sản phẩm

            tr(data-name="products-category_view")
              td Xem
              each item in roles1
                td.text-center
                  input(type="checkbox")

            tr(data-name="products-category_create")
              td Thêm mới
              each item in roles1
                td.text-center
                  input(type="checkbox")

            tr(data-name="products-category_edit")
              td Chỉnh sửa
              each item in roles1
                td.text-center
                  input(type="checkbox")

            tr(data-name="products-category_delete")
              td Xóa
              each item in roles1
                td.text-center
                  input(type="checkbox")

            tr
              td(colspan="4")
                b Sản phẩm

            tr(data-name="products_view")
              td Xem
              each item in roles1
                td.text-center
                  input(type="checkbox")

            tr(data-name="products_create")
              td Thêm mới
              each item in roles1
                td.text-center
                  input(type="checkbox")

            tr(data-name="products_edit")
              td Chỉnh sửa
              each item in roles1
                td.text-center
                  input(type="checkbox")

            tr(data-name="products_delete")
              td Xóa
              each item in roles1
                td.text-center
                  input(type="checkbox")

            tr
              td(colspan="4")
                b Tài khoản và nhóm quyền

            tr(data-name="roles_view")
              td Xem
              each item in roles1
                td.text-center
                  input(type="checkbox")

            tr(data-name="roles_create")
              td Thêm mới
              each item in roles1
                td.text-center
                  input(type="checkbox")

            tr(data-name="roles_edit")
              td Chỉnh sửa
              each item in roles1
                td.text-center
                  input(type="checkbox")

            tr(data-name="roles_delete")
              td Xóa
              each item in roles1
                td.text-center
                  input(type="checkbox")

            tr(data-name="roles_permissions")
              td Phân quyền
              each item in roles1
                td.text-center
                  input(type="checkbox")

        form#form-permissions.d-none(
          method="POST"
          action=`${prefixAdmin}/roles/permissions?_method=PATCH`
        )
          .form-group
            input.form-control(
              type="text"
              name="permissions"
            )

    script(src="/admin/js/roles.js")
