extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert(success, error)

  .auth-page
    .container
      .auth-card
        h1 Đổi mật khẩu
        p.auth-sub Tạo mật khẩu mới cho tài khoản của bạn

        form(action="/user/password/reset" method="POST")
          .form-group
            label(for="password") Mật khẩu mới
            input#password.form-control(
              type="password"
              name="password"
              required
            )
          .form-group
            label(for="confirmPassword") Xác nhận mật khẩu
            input#confirmPassword.form-control(
              type="password"
              name="confirmPassword"
              required
            )
          .form-group.mt-3
            button.btn.btn-primary.btn-block.w-100(type="submit") Đổi mật khẩu
