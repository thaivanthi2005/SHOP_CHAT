extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.page-shell
    include ../../partials/list-btn-users.pug

    .row
      .col-12
        +box-head("LỜI MỜI KẾT BẠN")

    .row(data-users-accept=user.id)
      each user in users
        .col-md-6(user-id=user.id)
          .box-user
            .inner-avatar
              img(src=(user.avatar ? user.avatar : "/images/default.jpg"), alt=user.fullName)
            .inner-info
              .inner-name #{user.fullName}
              .inner-buttons
                button.btn.btn-sm.btn-primary(btn-accept-friend=user.id) Chấp nhận
                button.btn.btn-sm.btn-secondary(btn-refuse-friend=user.id) Xóa
                button.btn.btn-sm.btn-secondary(btn-deleted-friend disabled) Đã xóa
                button.btn.btn-sm.btn-secondary(btn-accepted-friend disabled) Đã chấp nhận
block scripts
  script(type="module" src="/js/users.js")
