extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.page-shell
    include ../../partials/list-btn-users.pug

    .row
      .col-12
        +box-head("Lời Mời đã gửi")

    .row
      each user in users
        .col-md-6
          .box-user.add
            .inner-avatar
              img(src=(user.avatar ? user.avatar : "/images/default.jpg"), alt=user.fullName)
            .inner-info
              .inner-name #{user.fullName}
              .inner-buttons
                button.btn.btn-sm.btn-primary(btn-add-friend=user.id) Thêm bạn
                button.btn.btn-sm.btn-secondary(btn-cancel-friend=user.id) Hủy
block scripts
  script(type="module" src="/js/users.js")
