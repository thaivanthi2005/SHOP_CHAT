extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert(success, error)

  .auth-page
    .container
      .auth-card
        h1 Nhập mã OTP xác thực
        p.auth-sub Kiểm tra email và nhập mã OTP

        form(action="/user/password/otp" method="POST")
          .form-group
            label(for="email") Email
            input#email.form-control(
              type="email"
              name="email"
              required
              value=email
              readonly
            )
          .form-group
            label(for="otp") Mã OTP
            input#otp.form-control(
              type="text"
              name="otp"
              required
              placeholder="Nhập mã OTP"
            )
          .form-group.mt-3
            button.btn.btn-primary.w-100(type="submit") Xác nhận
