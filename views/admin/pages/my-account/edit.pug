extends ../../layouts/default.pug

block main
  .admin-page
    h1.page-title Cập nhật thông tin cá nhân

    form.admin-form(
      action=`${prefixAdmin}/my-account/edit?_method=PATCH`
      method="POST"
      enctype="multipart/form-data"
    )
      .form-group
        label(for="fullName") Họ tên *
        input#fullName.form-control(
          type="text"
          name="fullName"
          required
          value=user.fullName
        )

      .form-group
        label(for="email") Email *
        input#email.form-control(
          type="email"
          name="email"
          required
          value=user.email
        )

      .form-group
        label(for="password") Mật khẩu
        input#password.form-control(
          type="password"
          name="password"
        )

      .form-group
        label(for="phone") Số điện thoại
        input#phone.form-control(
          type="text"
          name="phone"
          value=user.phone
        )

      .form-group(upload-image)
        label(for="avatar") Avatar
        input#avatar.form-control-file(
          type="file"
          name="avatar"
          accept="image/*"
          upload-image-input
        )

        if (user.avatar)
          img.mt-3.mb-3.d-block(
            src=user.avatar
            alt="Preview"
            width="200"
            upload-image-preview
          )
          button.btn.btn-secondary(
            type="button"
            upload-image-delete
          ) Xóa ảnh

      button.btn.btn-primary(type="submit") Cập nhật
